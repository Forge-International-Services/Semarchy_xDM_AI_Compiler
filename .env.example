# Copy to .env and fill in. .env is gitignored — never commit real values.
#   set -a && source .env && set +a      # load into the shell

# --- Target xDM instance (O1) ------------------------------------------------
# This deployment is the Semarchy Native App on Snowpark Container Services.
# Do not type the URL from memory — retrieve it from Snowflake:
#     CALL <native_app_name>.xdm_public.xdm_server_url();
# REST endpoints are then at  https://<xdm_server_url>/semarchy/api/<endpoint>
SEMARCHY_URL=

# --- REST auth: TWO headers, TWO DIFFERENT SYSTEMS ---------------------------
# Authorization -> Snowflake.  SPCS gates ingress to the container service.
# API-key       -> Semarchy.   xDM authorizes the caller behind that gate.
#
# They are not two credentials for one system, which is what an earlier draft of
# this file assumed. See docs/Install/snowflake/deploy-in-snowflake.md
# § Access the REST API with programmatic access tokens.

# Snowflake programmatic access token (PAT), in Snowflake's CUSTOM header format:
#     Authorization: Snowflake Token="<your_pat>"
# The docs are explicit that SPCS endpoints "do not accept the standard Bearer
# authentication scheme" — it is neither Bearer nor Basic.
#
# THE DOUBLE QUOTES AROUND THE TOKEN ARE PART OF THE HEADER VALUE. Keep them, and
# WRAP THE WHOLE THING IN SINGLE QUOTES here, or `source .env` eats it:
#
#   SEMARCHY_AUTHORIZATION=Snowflake Token="abc123"     -> becomes  Snowflake
#       (the space ends the assignment; the rest is parsed as a command)
#   SEMARCHY_AUTHORIZATION='Snowflake Token="abc123"'   -> correct
#
# Fails as a 401 that looks like a bad token rather than a quoting mistake.
SEMARCHY_AUTHORIZATION='Snowflake Token="<your_pat>"'

# Semarchy xDM API key. Per docs/Admin/security/api-keys.md the controls that
# exist are ROLES, ORIGIN IP RESTRICTION and an EXPIRY DATE — there is no
# repository scoping (RED-TEAM RR1).
SEMARCHY_API_KEY=

# Fixed on every request; the whole contract lives here so nothing is guessed:
#   Content-Type: application/json
#   Accept: */*
#
# OPERATIONAL NOTE: PAT issuance, renewal and revocation are controlled by your
# Snowflake account configuration, so the token EXPIRES. A long refine loop can
# outlive it — treat a 401 as "token expired, ask the human", not as a bug.

# --- Local services ----------------------------------------------------------
# Postgres + pgvector store built by `python -m agent.rag build`.
# Local only, unrelated to the Snowflake deployment above.
SEMARCHY_RAG_DSN=postgresql:///semarchy_corpus
